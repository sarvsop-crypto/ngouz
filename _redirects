/security.txt /.well-known/security.txt 301

# Conventional /admin /cabinet shortcuts. Users frequently guess these
# paths (mirroring how WordPress/Drupal expose /admin); without these
# they hit a 404. Land them on the login pages — admin-boot/cabinet-
# chrome handle the token-aware routing from there (already-authed users
# bounce to dashboard).
/admin /admin-login 302
/admin/ /admin-login 302
/cabinet /cabinet/cabinet-login 302

# Generic /login + /signup shortcuts. Members are the larger user base
# so unqualified login/signup map to the cabinet flow; admins know the
# /admin-login path (or use the /admin shortcut above).
/login /cabinet/cabinet-login 302
/signin /cabinet/cabinet-login 302
/signup /cabinet/cabinet-register 302
/register /cabinet/cabinet-register 302

# iOS auto-probes /apple-touch-icon.png at root before checking the
# <link rel="apple-touch-icon"> tag. Without this fallback, only pages
# that declare the link (index.html) get the brand icon when added to
# the home screen — every other page lands a default browser icon.
/apple-touch-icon.png /img/apple-touch-icon.png 200
/apple-touch-icon-precomposed.png /img/apple-touch-icon.png 200

# Conventional RSS-discovery paths. Feed readers probe these before
# parsing <link rel="alternate"> in <head>; without these the news feed
# was unreachable from clients that don't crawl HTML metadata.
/feed.xml https://ngo-api-proxy.sarvsop.workers.dev/v1/news.rss 302
/rss.xml https://ngo-api-proxy.sarvsop.workers.dev/v1/news.rss 302
/rss https://ngo-api-proxy.sarvsop.workers.dev/v1/news.rss 302
/feed https://ngo-api-proxy.sarvsop.workers.dev/v1/news.rss 302

# Per-section feeds — users who guess /events.rss or /grants.rss
# (mirroring the news.rss pattern) shouldn't get 404. Worker exposes
# these on /v1/events.rss + /v1/grants.rss already; redirect for
# discoverability.
/events.rss https://ngo-api-proxy.sarvsop.workers.dev/v1/events.rss 302
/grants.rss https://ngo-api-proxy.sarvsop.workers.dev/v1/grants.rss 302
/news.rss https://ngo-api-proxy.sarvsop.workers.dev/v1/news.rss 302
